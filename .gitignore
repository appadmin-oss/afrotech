# NOTE: vendor/ (PHPMailer) and composer.lock are committed on purpose —
# shared cPanel hosting has no Composer/SSH, so the dependency ships with the
# app and needs no build step on deploy.
vendor/bin/

# Runtime storage (keep the dir, ignore contents)
/storage/*
!/storage/.gitkeep

# Local env / secrets
.env
*.local.php

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local screenshots
/.screenshots/
